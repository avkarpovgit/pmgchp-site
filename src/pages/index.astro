---
import Base from '../layouts/Base.astro';
import SectionCard from '../components/SectionCard.astro';

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Александр Карпов',
  alternateName: 'Карпов Александр Витальевич',
  url: 'https://pmgchp.ru/',
  image: 'https://pmgchp.ru/images/photo.jpg',
  jobTitle: 'Юрист по проектному финансированию и государственно-частному партнёрству',
  description: 'Юрист, специализирующийся на структурировании и сопровождении сделок проектного финансирования и ГЧП. Автор телеграм-канала «Правовой мониторинг ГЧП». Преподаватель факультета права НИУ ВШЭ.',
  email: 'mailto:pmgchp@gmail.com',
  knowsAbout: ['ГЧП', 'государственно-частное партнёрство', 'концессионные соглашения', 'проектное финансирование', 'инфраструктурные проекты', '115-ФЗ', '224-ФЗ', 'СЗПК'],
  sameAs: [
    'https://t.me/pmgchp',
    'https://boosty.to/avkarpov',
    'https://www.linkedin.com/in/karpovav',
  ],
};

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Правовой мониторинг ГЧП',
  alternateName: 'Сайт Александра Карпова',
  url: 'https://pmgchp.ru/',
  inLanguage: 'ru-RU',
  author: { '@type': 'Person', name: 'Александр Карпов' },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://pmgchp.ru/search/?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};
---

<Base
  title="Александр Карпов — юрист по проектному финансированию и ГЧП | Правовой мониторинг ГЧП"
  description="Карпов Александр Витальевич — юрист по проектному финансированию и государственно-частному партнёрству. Правовой мониторинг ГЧП: обзоры законодательства и судебной практики по концессиям."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(siteLd)} />
  <section class="hero">
    <div class="hero-top">
      <div class="hero-text">
        <h1>Александр Карпов</h1>
        <p class="subtitle">Юрист по проектному финансированию и государственно-частному партнёрству</p>
      </div>
      <img class="hero-photo" src="/images/photo.jpg" alt="Карпов Александр Витальевич" width="160" height="160" />
    </div>

    <p>
      Более 12 лет структурирую и сопровождаю сделки проектного финансирования и&nbsp;ГЧП —
      работал в крупных федеральных проектах на стороне государственного партнёра, консультанта,
      инвестора-строителя и&nbsp;финансирующей организации. С 2018 года преподаю авторский курс
      <a href="https://www.hse.ru/ma/interlaw/courses/838247647.html" target="_blank" rel="noopener">«Управление рисками в&nbsp;инвестиционных сделках»</a>
      на факультете права НИУ&nbsp;ВШЭ, член Экспертного совета
      <a href="https://asiic.ru" target="_blank" rel="noopener">АИИК</a>.
    </p>
  </section>

  <h2>На сайте</h2>
  <div class="section-cards">
    <SectionCard
      title="Мониторинг"
      titleHref="/monitoring/"
      meta={"Все выпуски →"}
      metaHref="/monitoring/"
      class="section-card--monitoring"
      watch={[
        { label: "Проекты НПА →", href: "/monitoring/drafts/" },
        { label: "Акты, ожидающие вступления в силу →", href: "/monitoring/pending/" },
      ]}
    >
      Обзоры изменений законодательства в сфере ГЧП с 2020 года
    </SectionCard>
    <SectionCard href="/news/" title="Новости" meta="Все выпуски →">
      Еженедельный дайджест событий в сфере ГЧП и проектного финансирования
    </SectionCard>
    <SectionCard href="/blog/" title="Блог" meta="Все записи →">
      Мои комментарии и мнения по отдельным вопросам
    </SectionCard>
    <SectionCard href="https://t.me/pmgchp" title="Telegram-канал" meta="Подписаться ↗" target="_blank" rel="noopener">
      Мониторинг и комментарии в канале с 900+ подписчиков
    </SectionCard>
    <SectionCard href="/experience/" title="Обо мне" meta="Подробнее →">
      Карьера, преподавание, публикации и профессиональные сообщества
    </SectionCard>
  </div>

  <h2>Контакты</h2>
  <ul class="contact-list">
    <li><span class="label">Email</span> <a href="mailto:pmgchp@gmail.com">pmgchp@gmail.com</a></li>
    <li><span class="label">LinkedIn</span> <a href="https://www.linkedin.com/in/karpovav" target="_blank" rel="noopener">linkedin.com/in/karpovav</a></li>
  </ul>
</Base>
