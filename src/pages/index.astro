---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import releases from '../data/monitoring.json';

const postCount = (await getCollection('blog', ({ data }) => !data.draft)).length;
const releaseCount = releases.length;

function plural(n: number, one: string, few: string, many: string) {
  const m10 = n % 10, m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return few;
  return many;
}

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Александр Карпов',
  alternateName: 'Карпов Александр Витальевич',
  url: 'https://pmgchp.ru/',
  image: 'https://pmgchp.ru/images/photo.jpg',
  jobTitle: 'Юрист по проектному финансированию и государственно-частному партнёрству',
  description: 'Юрист, специализирующийся на структурировании и сопровождении сделок проектного финансирования и ГЧП. Автор телеграм-канала «Правовой мониторинг ГЧП». Преподаватель факультета права НИУ ВШЭ.',
  email: 'mailto:pmgchp@gmail.com',
  knowsAbout: ['ГЧП', 'государственно-частное партнёрство', 'концессионные соглашения', 'проектное финансирование', 'инфраструктурные проекты', '115-ФЗ', '224-ФЗ', 'СЗПК'],
  sameAs: [
    'https://t.me/pmgchp',
    'https://boosty.to/avkarpov',
    'https://www.linkedin.com/in/karpovav',
  ],
};

const siteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Правовой мониторинг ГЧП',
  alternateName: 'Сайт Александра Карпова',
  url: 'https://pmgchp.ru/',
  inLanguage: 'ru-RU',
  author: { '@type': 'Person', name: 'Александр Карпов' },
};
---

<Base title="Александр Карпов — юрист по проектному финансированию и ГЧП | Правовой мониторинг ГЧП">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(personLd)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(siteLd)} />
  <section class="hero">
    <div class="hero-top">
      <div class="hero-text">
        <h1>Александр Карпов</h1>
        <p class="subtitle">Юрист по проектному финансированию и государственно-частному партнёрству</p>
      </div>
      <img class="hero-photo" src="/images/photo.jpg" alt="Александр Карпов" width="160" height="160" />
    </div>

    <p>
      Более 12 лет структурирую и сопровождаю сделки проектного финансирования и&nbsp;ГЧП —
      работал в крупных федеральных проектах на стороне государственного партнёра, консультанта,
      инвестора-строителя и&nbsp;финансирующей организации. С 2018 года преподаю авторский курс
      <a href="https://www.hse.ru/ma/interlaw/courses/838247647.html" target="_blank" rel="noopener">«Управление рисками в&nbsp;инвестиционных сделках»</a>
      на факультете права НИУ&nbsp;ВШЭ, член Экспертного совета
      <a href="https://asiic.ru" target="_blank" rel="noopener">АИИК</a>.
    </p>
  </section>

  <h2>Фокус практики</h2>
  <ul class="focus-list">
    <li><strong>Проектное финансирование</strong> — структурирование сделок, кредитная документация, финансовое закрытие, сопровождение выдачи траншей</li>
    <li><strong>Концессии и ГЧП</strong> — подготовка и изменение соглашений, ЧКИ и конкурсы, сопровождение на всех стадиях проекта</li>
    <li><strong>Риски участников</strong> — матрицы рисков и рекомендации для публичной стороны, инвесторов и кредиторов</li>
  </ul>

  <h2>На сайте</h2>
  <div class="section-cards">
    <a class="section-card" href="/monitoring/">
      <h3>Мониторинг</h3>
      <p>Обзоры правовых актов и судебной практики по ГЧП с 2020 года</p>
      <span class="card-meta">{releaseCount} {plural(releaseCount, 'выпуск', 'выпуска', 'выпусков')} →</span>
    </a>
    <a class="section-card" href="/blog/">
      <h3>Блог</h3>
      <p>Статьи и разборы: законопроекты, бюджет, судебные споры, облигации</p>
      <span class="card-meta">{postCount} {plural(postCount, 'запись', 'записи', 'записей')} →</span>
    </a>
    <a class="section-card" href="https://t.me/pmgchp" target="_blank" rel="noopener">
      <h3>Telegram-канал</h3>
      <p>Оперативные комментарии к изменениям законодательства о концессиях и ГЧП</p>
      <span class="card-meta">900+ подписчиков ↗</span>
    </a>
    <a class="section-card" href="/experience/">
      <h3>Опыт</h3>
      <p>Карьера, преподавание, публикации и профессиональные сообщества</p>
      <span class="card-meta">Подробнее →</span>
    </a>
  </div>

  <h2>Контакты</h2>
  <ul class="contact-list">
    <li><span class="label">Email</span> <a href="mailto:pmgchp@gmail.com">pmgchp@gmail.com</a></li>
    <li><span class="label">LinkedIn</span> <a href="https://www.linkedin.com/in/karpovav" target="_blank" rel="noopener">linkedin.com/in/karpovav</a></li>
  </ul>
</Base>
