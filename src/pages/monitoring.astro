---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import releases from '../data/monitoring.json';

type Release = { id: number; date: string; period: string; items: string[] };

const pages = await getCollection('monitoring');
const pageByTgId = new Map<number, string>(pages.map((p) => [p.data.tgId, p.id]));

const byYear = new Map<string, Release[]>();
for (const r of releases as Release[]) {
  const year = r.date.slice(0, 4);
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(r);
}
const years = [...byYear.keys()].sort((a, b) => b.localeCompare(a));

const cleanPeriod = (p: string) => p.replace(/\s*г\.?\s*$/, '').replace(/\s+-\s+/g, ' — ');
---

<Base
  title="Еженедельный правовой мониторинг ГЧП — архив выпусков"
  description="Архив еженедельного правового мониторинга ГЧП: ключевые нормативные акты и судебная практика по концессиям и государственно-частному партнёрству с 2020 года."
>
  <h1>Правовой мониторинг</h1>
  <p class="subtitle" style="color: var(--text-muted); margin-top: 0.5rem;">
    Еженедельные обзоры ключевых правовых актов и судебных решений в сфере ГЧП и концессий.
    Выходят в телеграм-канале <a href="https://t.me/pmgchp" target="_blank" rel="noopener">«Правовой мониторинг ГЧП»</a> с июня 2020 года.
  </p>

  <nav class="anchor-nav">
    {years.map((y) => <a href={`#y${y}`}>{y}</a>)}
  </nav>

  {years.map((year) => (
    <section>
      <h2 id={`y${year}`}>{year}</h2>
      <ul class="monitoring-list">
        {byYear.get(year)!.map((r) => {
          const slug = pageByTgId.get(r.id);
          return (
            <li>
              {slug ? (
                <a href={`/monitoring/${slug}/`}>{cleanPeriod(r.period)}</a>
              ) : (
                <a href={`https://t.me/pmgchp/${r.id}`} target="_blank" rel="noopener">{cleanPeriod(r.period)}</a>
              )}
              <a class="release-tg" href={`https://t.me/pmgchp/${r.id}`} target="_blank" rel="noopener" title="Выпуск в Telegram">TG ↗</a>
              {r.items.length > 0 && (
                <ul class="release-items">
                  {r.items.map((item) => <li>{item}</li>)}
                </ul>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Base>
