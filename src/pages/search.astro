---
import Base from '../layouts/Base.astro';
---

<Base title="Поиск — Правовой мониторинг ГЧП" description="Поиск по новостям ГЧП, статьям блога и архиву правового мониторинга.">
  <h1>Поиск</h1>
  <p style="color: var(--text-muted);">
    По новостям, блогу и архиву мониторинга — например, «МГД», «капитальный грант» или номер закона.
  </p>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <noscript>
    <p>
      Для работы поиска нужен включённый JavaScript. Альтернатива — поиск по
      <a href="https://t.me/s/pmgchp" target="_blank" rel="noopener">веб-версии телеграм-канала</a>
      или разделы <a href="/news/">«Новости»</a>, <a href="/blog/">«Блог»</a> и <a href="/monitoring/">«Мониторинг»</a>.
    </p>
  </noscript>
  <div id="search" class="search-box">Поиск загружается…</div>
  <!-- Объявление числа результатов для экранных дикторов: Pagefind Default UI сам его не озвучивает (WCAG 4.1.3) -->
  <div id="search-status" class="visually-hidden" role="status" aria-live="polite"></div>

  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (typeof PagefindUI === 'undefined') {
        document.getElementById('search').textContent =
          'Не удалось загрузить поиск. Обновите страницу или воспользуйтесь разделами «Новости», «Блог» и «Мониторинг».';
        return;
      }
      document.getElementById('search').textContent = '';
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: 'Что ищем?',
          zero_results: 'Ничего не найдено по запросу «[SEARCH_TERM]»',
          many_results: 'Найдено результатов: [COUNT] — по запросу «[SEARCH_TERM]»',
          one_result: 'Найден [COUNT] результат по запросу «[SEARCH_TERM]»',
          clear_search: 'Очистить',
          load_more: 'Показать ещё',
          searching: 'Ищем «[SEARCH_TERM]»…',
        },
      });
      // Копируем итоговое сообщение Pagefind в живую область с задержкой,
      // чтобы при наборе не объявлять каждое промежуточное «Ищем…».
      var status = document.getElementById('search-status');
      var announceTimer = null;
      new MutationObserver(function () {
        clearTimeout(announceTimer);
        announceTimer = setTimeout(function () {
          var m = document.querySelector('#search .pagefind-ui__message');
          var text = m ? m.textContent.trim() : '';
          if (status.textContent !== text) status.textContent = text;
        }, 700);
      }).observe(document.getElementById('search'), { childList: true, subtree: true, characterData: true });

      var input = document.querySelector('#search input');
      var q = new URLSearchParams(location.search).get('q');
      if (input && q) {
        input.value = q;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
      if (input && window.matchMedia('(pointer: fine)').matches && window.innerWidth >= 900) {
        input.focus();
      }
    });
  </script>

  <style is:inline>
    .search-box {
      --pagefind-ui-primary: var(--accent-dark);
      --pagefind-ui-text: var(--text);
      --pagefind-ui-background: var(--card-bg);
      --pagefind-ui-border: var(--border);
      --pagefind-ui-tag: var(--border);
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 8px;
      --pagefind-ui-font: inherit;
      margin-top: 1.5rem;
    }
  </style>
</Base>
