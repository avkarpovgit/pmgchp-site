---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { tagSlug } from '../../utils/tags';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const tagCounts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t: string) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

const formatDate = (d: Date) =>
  d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Блог — Александр Карпов" description="Статьи и обзоры о праве ГЧП, концессиях и проектном финансировании.">
  <h1>Блог</h1>
  <p class="subtitle" style="color: var(--text-muted); margin-top: 0.5rem;">
    Статьи и обзоры о праве ГЧП, концессиях и проектном финансировании.
  </p>

  <div class="tag-cloud">
    {allTags.map(([tag, count]) => (
      <a class="tag-chip" href={`/blog/tag/${tagSlug(tag)}/`}>{tag} <span>{count}</span></a>
    ))}
  </div>

  {posts.length === 0 ? (
    <div class="callout">
      <p>
        Здесь скоро появятся развёрнутые материалы. Пока — короткие форматы в телеграм-канале
        <a href="https://t.me/pmgchp" target="_blank" rel="noopener">«Правовой мониторинг ГЧП»</a>
        и посты на <a href="https://boosty.to/avkarpov" target="_blank" rel="noopener">Boosty</a>.
      </p>
    </div>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <span class="post-date">{formatDate(post.data.date)}</span>
          <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
          {post.data.description && <p class="excerpt">{post.data.description}</p>}
        </li>
      ))}
    </ul>
  )}
</Base>
