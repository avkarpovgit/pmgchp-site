---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { tagSlug } from '../../utils/tags';
import Callout from '../../components/Callout.astro';
import PostListItem from '../../components/PostListItem.astro';
import Tag from '../../components/Tag.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// оценка времени чтения для эйброу (П2): ~1500 знаков в минуту, минимум 1 мин
const readMinutes = (p: (typeof posts)[number]) =>
  Math.max(1, Math.round(((p as { body?: string }).body ?? '').length / 1500));

const tagCounts = new Map<string, number>();
posts.forEach((p) => p.data.tags.forEach((t: string) => tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)));
const allTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<Base title="Блог — Александр Карпов" description="Статьи и обзоры о праве ГЧП, концессиях и проектном финансировании.">
  <h1>Блог</h1>
  <p class="subtitle" style="color: var(--text-muted); margin-top: 0.5rem;">
    Статьи и обзоры о праве ГЧП, концессиях и проектном финансировании.
  </p>

  <div class="tag-cloud">
    {allTags.map(([tag, count]) => (
      <Tag name={tag} href={`/blog/tag/${tagSlug(tag)}/`} count={count} />
    ))}
  </div>

  {posts.length === 0 ? (
    <Callout>
      <p>
        Здесь скоро появятся развёрнутые материалы. Пока — короткие форматы в телеграм-канале
        <a href="https://t.me/pmgchp" target="_blank" rel="noopener">«Правовой мониторинг ГЧП»</a>
        и посты на <a href="https://boosty.to/avkarpov" target="_blank" rel="noopener">Boosty</a>.
      </p>
    </Callout>
  ) : (
    <ul class="post-list">
      {posts.map((post) => (
        <PostListItem date={post.data.date} href={`/blog/${post.id}/`} title={post.data.title} excerpt={post.data.description} minutes={readMinutes(post)} />
      ))}
    </ul>
  )}
</Base>
