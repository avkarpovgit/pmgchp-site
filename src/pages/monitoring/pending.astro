---
import Base from '../../layouts/Base.astro';
import { getPendingActs } from '../../utils/monitoring';
import Callout from '../../components/Callout.astro';

const pending = await getPendingActs(); // отсортированы по дате вступления в силу (возр.)

const MONTHS_NOM = ['Январь', 'Февраль', 'Март', 'Апрель', 'Май', 'Июнь', 'Июль', 'Август', 'Сентябрь', 'Октябрь', 'Ноябрь', 'Декабрь'];
const MONTHS_SHORT = ['янв', 'фев', 'мар', 'апр', 'мая', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];

type Row =
  | { kind: 'month'; label: string }
  | ({ kind: 'act'; day: number; mon: number; year: number } & (typeof pending)[number]);

const rows: Row[] = [];
let lastMonthKey = '';
for (const a of pending) {
  const [y, m, d] = a.iso.split('-').map(Number);
  const monthKey = `${y}-${m}`;
  if (monthKey !== lastMonthKey) {
    rows.push({ kind: 'month', label: `${MONTHS_NOM[m - 1]} ${y}` });
    lastMonthKey = monthKey;
  }
  rows.push({ kind: 'act', ...a, day: d, mon: m, year: y });
}
---

<Base
  title="Акты, ожидающие вступления в силу — Правовой мониторинг ГЧП"
  description="Принятые нормативные акты из правового мониторинга ГЧП, срок вступления в силу которых ещё не наступил — на наглядной шкале времени по датам вступления в силу."
>
  <h1>Акты, ожидающие вступления в силу</h1>
  <p class="subtitle" style="color: var(--text-muted); margin-top: 0.5rem;">
    Принятые акты из выпусков мониторинга, срок вступления в силу которых ещё не наступил —
    на шкале времени по датам. Список формируется автоматически по всем выпускам.
  </p>

  {pending.length === 0 ? (
    <Callout><p>Сейчас все упомянутые в мониторинге акты уже вступили в силу.</p></Callout>
  ) : (
    <div class="cal-timeline">
      {rows.map((r) => (
        r.kind === 'month' ? (
          <div class="cal-monthhead">{r.label}</div>
        ) : (
          <div class="cal-act">
            <div class="cal-date">
              <span class="visually-hidden">Вступает в силу {r.day} {MONTHS_SHORT[r.mon - 1]} {r.year}</span>
              <span class="cal-day" aria-hidden="true">{r.day}</span>
              <span class="cal-mon" aria-hidden="true">{MONTHS_SHORT[r.mon - 1]} {r.year}</span>
            </div>
            <div class="cal-body">
              <a class="cal-title" href={r.url} target="_blank" rel="noopener">{r.title}</a>
              <span class="cal-src">из выпуска <a href={`/monitoring/${r.slug}/`}>{r.period}</a> <span class="days-left" data-iso={r.iso}></span></span>
            </div>
          </div>
        )
      ))}
    </div>
  )}

  <p style="margin-top: 3rem;"><a href="/monitoring/">← Назад к мониторингу</a></p>

  <script is:inline>
    // Приписка «· через N дней» к дате вступления в силу (П4): считается на клиенте,
    // потому что сборка статическая и build-time значение устаревает между деплоями.
    // Точная дата в пилюле остаётся всегда — приписка только дополняет её (горизонт ≤ 45 дней).
    (function () {
      function plural(n, forms) {
        var n10 = n % 10;
        var n100 = n % 100;
        if (n10 === 1 && n100 !== 11) return forms[0];
        if (n10 >= 2 && n10 <= 4 && (n100 < 10 || n100 >= 20)) return forms[1];
        return forms[2];
      }
      var today = new Date();
      today.setHours(0, 0, 0, 0);
      document.querySelectorAll('.days-left[data-iso]').forEach(function (el) {
        var p = el.getAttribute('data-iso').split('-');
        var d = new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
        var days = Math.round((d.getTime() - today.getTime()) / 86400000);
        if (days <= 0 || days > 45) return;
        el.textContent = days === 1 ? '· завтра' : '· через ' + days + ' ' + plural(days, ['день', 'дня', 'дней']);
      });
    })();
  </script>
</Base>
