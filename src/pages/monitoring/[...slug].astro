---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const releases = await getCollection('monitoring');
  return releases.map((r) => ({
    params: { slug: r.id },
    props: { release: r },
  }));
}

const { release } = Astro.props;
const { Content } = await render(release);

const formatDate = (d: Date) =>
  d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title={`${release.data.title} — Правовой мониторинг ГЧП`}
  description={`Правовой мониторинг ГЧП за ${release.data.period}: ключевые нормативные акты и судебная практика по концессиям и государственно-частному партнёрству.`}
  ogType="article"
  publishDate={release.data.date}
  breadcrumb={[{ name: 'Главная', href: '/' }, { name: 'Мониторинг', href: '/monitoring/' }, { name: release.data.title, href: `/monitoring/${release.id}/` }]}
>
  <article>
    <header class="article-header">
      <p class="post-date">{formatDate(release.data.date)}</p>
      <h1>{release.data.title}</h1>
    </header>
    <div class="prose feed-lead">
      <Content />
    </div>
  </article>
  <p style="margin-top: 3rem;"><a href="/monitoring/">← Все выпуски мониторинга</a></p>
</Base>
