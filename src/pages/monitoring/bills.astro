---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const billEntries = (await getCollection('bills', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const bills = await Promise.all(
  billEntries.map(async (b) => ({ data: b.data, Content: (await render(b)).Content })),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  title="Законопроекты на рассмотрении — Правовой мониторинг ГЧП"
  description="Проекты федеральных законов в сфере ГЧП, бюджета и инфраструктуры на рассмотрении в Госдуме. Статус прохождения обновляется автоматически по данным СОЗД."
>
  <h1>Законопроекты на рассмотрении</h1>
  <p class="subtitle" style="color: var(--text-muted); margin-top: 0.5rem;">
    Проекты федеральных законов в сфере ГЧП, бюджета и инфраструктуры, которые мы отслеживаем.
    Статус прохождения обновляется автоматически раз в сутки по данным
    <a href="https://sozd.duma.gov.ru/" target="_blank" rel="noopener">Системы обеспечения законодательной деятельности</a> Госдумы.
  </p>

  {bills.length === 0 ? (
    <div class="callout"><p>Сейчас отслеживаемых законопроектов нет.</p></div>
  ) : (
    <ul class="bills-list">
      {bills.map((b) => (
        <li class="bill-item">
          <div class="bill-head">
            <span class="bill-status">{b.data.status}</span>
            <span class="bill-number">№ {b.data.number}</span>
          </div>
          <h2 class="bill-title">{b.data.title}</h2>
          <div class="bill-links">
            {b.data.sozd && <a class="bill-link" href={b.data.sozd} target="_blank" rel="noopener">Паспорт на сайте Госдумы&nbsp;↗</a>}
            {b.data.consultant && <a class="bill-link" href={b.data.consultant} target="_blank" rel="noopener">Текст проекта&nbsp;↗</a>}
            {b.data.passport && <a class="bill-link" href={b.data.passport} target="_blank" rel="noopener">Паспорт (КонсультантПлюс)&nbsp;↗</a>}
          </div>
          <div class="bill-body"><b.Content /></div>
          {b.data.stages && b.data.stages.length > 0 && (
            <details class="release-details bill-history">
              <summary>История прохождения ({b.data.stages.length})</summary>
              <ul class="stage-list">
                {b.data.stages.slice().reverse().map((s) => (
                  <li><span class="stage-date">{formatDate(s.date)}</span> {s.stage}</li>
                ))}
              </ul>
            </details>
          )}
        </li>
      ))}
    </ul>
  )}

  <p style="margin-top: 3rem;"><a href="/monitoring/">← Назад к мониторингу</a></p>
</Base>
