---
// Тизер «что мы отслеживаем» (страница мониторинга). Счётчик — через slot
// (внутри plural() и неразрывные пробелы).
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a class="watch-teaser" href={href}>
  <span class="watch-teaser-label">{label}</span>
  <span class="watch-teaser-count"><slot /></span>
</a>
