---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishDate?: Date;
}

const {
  title,
  description = 'Александр Карпов — юрист по проектному финансированию и государственно-частному партнёрству. Правовой мониторинг ГЧП: обзоры законодательства и судебной практики по концессиям и ГЧП.',
  ogType = 'website',
  ogImage = '/images/og-default.jpg',
  publishDate,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const navItems = [
  { href: '/', label: 'Главная' },
  { href: '/experience/', label: 'Опыт' },
  { href: '/blog/', label: 'Блог' },
  { href: '/monitoring/', label: 'Мониторинг' },
  { href: '/search/', label: 'Поиск' },
];

function isCurrent(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const articleLd = ogType === 'article' && publishDate ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: publishDate.toISOString().slice(0, 10),
  inLanguage: 'ru-RU',
  url: canonicalURL.toString(),
  author: {
    '@type': 'Person',
    name: 'Александр Карпов',
    url: 'https://pmgchp.ru/',
  },
  publisher: {
    '@type': 'Person',
    name: 'Александр Карпов',
  },
} : null;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdfcfa" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#221426" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Александр Карпов, Правовой мониторинг ГЧП, ГЧП, государственно-частное партнёрство, концессии, концессионные соглашения, проектное финансирование, 115-ФЗ, 224-ФЗ, СЗПК, юрист ГЧП" />
    <meta name="author" content="Александр Карпов" />
    <meta name="google-site-verification" content="DPQx7Y-gzJYkhpnbh3GO2rWTOWgFcq3uXSOU5AvvPF4" />
    <meta name="yandex-verification" content="e6aa673dd3a0029c" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="Правовой мониторинг ГЧП — блог" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Правовой мониторинг ГЧП" />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <slot name="head" />

    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-title">
          <img src="/images/logo-pmgchp.png" alt="" class="site-logo" width="28" height="28" />
          Правовой мониторинг ГЧП
        </a>
        <nav class="site-nav">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href="https://t.me/pmgchp" target="_blank" rel="noopener">Telegram&nbsp;↗</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Александр Карпов</span>
        <span>
          <a href="https://t.me/pmgchp" target="_blank" rel="noopener">Telegram</a> ·
          <a href="https://boosty.to/avkarpov" target="_blank" rel="noopener">Boosty</a> ·
          <a href="mailto:pmgchp@gmail.com">pmgchp@gmail.com</a>
        </span>
      </div>
      <div class="container footer-legal">
        <span>
          Материалы сайта — <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ru" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a> ·
          <a href="/terms/">Пользовательское соглашение</a> ·
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
    <script is:inline>
      // Свайп влево/вправо между разделами на мобильных
      (function () {
        if (!('ontouchstart' in window) || !window.matchMedia('(max-width: 768px)').matches) return;
        var sections = ['/', '/experience/', '/blog/', '/monitoring/'];
        var path = location.pathname;
        var current = sections.indexOf(path);
        if (current === -1) {
          // на странице поста блога считаем текущим разделом «Блог»
          for (var i = sections.length - 1; i > 0; i--) {
            if (path.indexOf(sections[i]) === 0) { current = i; break; }
          }
        }
        if (current === -1) return; // /terms и прочее — без свайпов

        var x0 = null, y0 = null, t0 = 0, skip = false;

        function insideHScroll(el) {
          while (el && el !== document.body) {
            if (el.scrollWidth > el.clientWidth + 5) return true;
            el = el.parentElement;
          }
          return false;
        }

        document.addEventListener('touchstart', function (e) {
          var t = e.touches[0];
          x0 = t.clientX; y0 = t.clientY; t0 = Date.now();
          skip = insideHScroll(e.target);
        }, { passive: true });

        document.addEventListener('touchend', function (e) {
          if (x0 === null || skip) { x0 = null; return; }
          var t = e.changedTouches[0];
          var dx = t.clientX - x0, dy = t.clientY - y0, dt = Date.now() - t0;
          x0 = null;
          if (dt > 600) return;                       // слишком медленно — не жест
          if (Math.abs(dx) < 70) return;              // слишком коротко
          if (Math.abs(dy) > Math.abs(dx) * 0.6) return; // не горизонтально
          var next = dx < 0 ? current + 1 : current - 1;
          if (next < 0 || next >= sections.length) return;
          location.href = sections[next];
        }, { passive: true });
      })();
    </script>
  </body>
</html>
