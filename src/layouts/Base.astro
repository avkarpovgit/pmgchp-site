---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  publishDate?: Date;
}

const {
  title,
  description = 'Александр Карпов — юрист по проектному финансированию и государственно-частному партнёрству. Правовой мониторинг ГЧП: обзоры законодательства и судебной практики по концессиям и ГЧП.',
  ogType = 'website',
  ogImage = '/images/og-default.jpg',
  publishDate,
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalURL = new URL(currentPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

const navItems = [
  { href: '/', label: 'Главная' },
  { href: '/experience/', label: 'Опыт' },
  { href: '/blog/', label: 'Блог' },
];

function isCurrent(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const articleLd = ogType === 'article' && publishDate ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  datePublished: publishDate.toISOString().slice(0, 10),
  inLanguage: 'ru-RU',
  url: canonicalURL.toString(),
  author: {
    '@type': 'Person',
    name: 'Александр Карпов',
    url: 'https://pmgchp.ru/',
  },
  publisher: {
    '@type': 'Person',
    name: 'Александр Карпов',
  },
} : null;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Александр Карпов, Правовой мониторинг ГЧП, ГЧП, государственно-частное партнёрство, концессии, концессионные соглашения, проектное финансирование, 115-ФЗ, 224-ФЗ, СЗПК, юрист ГЧП" />
    <meta name="author" content="Александр Карпов" />
    <meta name="google-site-verification" content="DPQx7Y-gzJYkhpnbh3GO2rWTOWgFcq3uXSOU5AvvPF4" />
    <meta name="yandex-verification" content="e6aa673dd3a0029c" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="Правовой мониторинг ГЧП — блог" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Правовой мониторинг ГЧП" />
    {publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {articleLd && <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />}
    <slot name="head" />

    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a href="/" class="site-title">Правовой мониторинг ГЧП</a>
        <nav class="site-nav">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <a href="https://t.me/pmgchp" target="_blank" rel="noopener">Telegram&nbsp;↗</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} Александр Карпов</span>
        <span>
          <a href="https://t.me/pmgchp" target="_blank" rel="noopener">Telegram</a> ·
          <a href="https://boosty.to/avkarpov" target="_blank" rel="noopener">Boosty</a> ·
          <a href="mailto:pmgchp@gmail.com">pmgchp@gmail.com</a>
        </span>
      </div>
      <div class="container footer-legal">
        <span>
          Материалы сайта — <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ru" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a> ·
          <a href="/terms/">Пользовательское соглашение</a> ·
          <a href="/rss.xml">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>
