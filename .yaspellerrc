{
  "lang": "ru",
  "format": "markdown",
  "ignoreTags": ["code", "kbd", "object", "pre", "script", "style"],
  "ignoreUrls": true,
  "findRepeatWords": true,
  "fileExtensions": [".md"],
  "excludeFiles": ["node_modules", "dist", "src/data"],
  "dictionary": [
    "ГЧП", "СЗПК", "СОЗД", "ОКН", "ЦФА", "ДИС", "СФУК", "СПИК", "ОЭЗ", "ППК", "МГД", "КРТ", "СГЧП", "ФНБ", "НМЦК", "ФССЦ", "ФСНБ", "СРО", "МСФО", "ГИКЭ", "ПМЭФ",
    "Карпов", "Карпова", "Качкин", "Качкина", "Решетников", "Шохин", "Глотов", "Глотова", "Новиков", "Костин", "Кондратьев", "Кутепов", "Хапсироков", "Наролин",
    "АИИК", "НАИК", "Росинфра", "Мосбиржа", "Промсвязьбанк", "Совкомбанк", "Газпромбанк",
    "концедент", "концедента", "концеденту", "концедентом", "концеденте",
    "концессионер", "концессионера", "концессионеру", "концессионером", "концессионере", "концессионеры", "концессионеров", "концессионерам",
    "офсетный", "офсетные", "офсетных", "офтейк", "квазизелёные", "эндаумент", "эндаументы", "тарифообразование",
    "Uzbekistan", "PPP", "ИТ", "ВСМ", "Пулково", "Новороссийска", "Забайкалья", "Уфе"
  ]
}
